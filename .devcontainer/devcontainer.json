{
	"name": "pycharm-regression",
	"image": "mcr.microsoft.com/devcontainers/miniconda:1-3",
	// "build": {
	// 	"dockerfile": "Dockerfile",
	// 	"context": "."
	// },
	"remoteUser": "vscode",
	"containerUser": "vscode",
	"workspaceFolder": "/workspace/pycharm-regression",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace/pycharm-regression,type=bind",
	"containerEnv": {
		"CONDA_ENVS_PATH": "/home/vscode/envs",
		"PATH": "/home/vscode/envs/app/bin:/opt/conda/bin:/opt/conda/condabin:/home/vscode/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
		"PYCHARM_PYTHON_PATH": "/home/vscode/envs/app/bin/python"
	},
	"onCreateCommand": "/workspace/pycharm-regression/.devcontainer/setup-workspace.sh"
}
